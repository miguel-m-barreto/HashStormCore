        "publishUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowedClientPublicKeys": {
          "description": "ZeroMQ CURVE client public keys allowed to connect. Each key must be a 40-character Z85 public key.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 40,
            "maxLength": 40,
            "pattern": "^[0-9A-Za-z.\\-:+=^!/*?&<>()\\[\\]{}@%$#]{40}$"
          }
        },
        "curveServerSecretKey": {
          "description": "ZeroMQ CURVE server secret key. Must be a 40-character Z85 secret key.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 40,
          "maxLength": 40,
